# EAS cloud builds run "npm install --include=dev", which executes
# package prepare scripts. react-native-screens@3.x prepare script
# ("bob build") fails on EAS because there is no tsconfig.json in its
# project root. The published tarball already ships prebuilt lib/ output
# and Android sources, and Expo managed builds do not need these scripts,
# so skip lifecycle scripts entirely (same workaround CI uses locally).
ignore-scripts=true
