{
  "expo": {
    "name": "Rally",
    "slug": "rally",
    "scheme": "rally",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rally.mobile",
      "associatedDomains": ["applinks:rally.app"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1D3A"
      },
      "package": "app.rally.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "rally.app", "pathPrefix": "/f" },
            { "scheme": "rally", "host": "*" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": ["expo-router"]
  }
}
