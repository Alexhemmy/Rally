{
  "expo": {
    "name": "Rally",
    "slug": "rally",
    "scheme": "rally",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rally.mobile",
      "associatedDomains": ["applinks:rally.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B1D3A"
      },
      "package": "app.rally.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "rally.app", "pathPrefix": "/f" },
            { "scheme": "rally", "host": "*" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Rally to use your camera to take photos and videos.",
          "photosPermission": "Allow Rally to access your photo library to pick media."
        }
      ],
      "expo-local-authentication",
      "expo-notifications"
    ]
  }
}
