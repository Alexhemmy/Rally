# Copy this file to mobile/.env (already gitignored) for local dev.
# NOTE: .env values are only used by expo start / local builds;
# EAS cloud builds read env vars from eas.json profiles or the
# expo.dev dashboard (Project -> Environment Variables), not from .env.

# Local backend URL for the iOS simulator
EXPO_PUBLIC_API_URL=http://localhost:4000
# For the Android emulator use http://10.0.2.2:4000 instead.
