DATABASE_URL="postgresql://rally:rally@localhost:5432/rally?schema=public"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
DEFAULT_LOCALE=en

# Payments — recommended: Paystack (NG/GH), Flutterwave (multi-Africa), Stripe (global web)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# KYC — recommended: Smile Identity (Africa), Sumsub (global)
KYC_PROVIDER=mock
SMILE_API_KEY=
SMILE_PARTNER_ID=
SMILE_BASE_URL=https://api.smileidentity.com/v1
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Live video — recommended: LiveKit (or Agora)
LIVE_PROVIDER=mock
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Translation — DeepL or Google
TRANSLATE_PROVIDER=mock
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
