DATABASE_URL="postgresql://rally:rally@localhost:5432/rally?schema=public"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="30d"
# Sliding session: logout after 7 days without authenticated activity
SESSION_INACTIVITY_DAYS=7
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
APP_ORIGINS="http://localhost:3000"
DEFAULT_LOCALE=en
WEB_URL="http://localhost:3000"

# Email / OTP — Gmail SMTP via nodemailer (P3)
# Create the app password at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="hello@yourdomain.com"
SMTP_PASS="your-16-char-google-app-password"
MAIL_FROM="Rally <hello@yourdomain.com>"

# SMS (phone OTP primary channel) — recommended: Termii (NG), Twilio (global)
SMS_PROVIDER=
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Payments — recommended: Paystack (NG/GH), Flutterwave (multi-Africa), Stripe (global web)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# KYC — recommended: Smile Identity (Africa), Sumsub (global)
KYC_PROVIDER=mock
SMILE_API_KEY=
SMILE_PARTNER_ID=
SMILE_BASE_URL=https://api.smileidentity.com/v1
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Live video — recommended: LiveKit (or Agora)
LIVE_PROVIDER=mock
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Translation — DeepL or Google
TRANSLATE_PROVIDER=mock
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
