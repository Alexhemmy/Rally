// Rally Fan Support Platform - Database Schema
// Based on PRD Draft v1.0 - MVP + P0 features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Accounts ───────────────────────────────────────────────────

enum UserRole {
  FAN
  FAVORITE
  MANAGER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phone             String?            @unique
  passwordHash      String?
  googleId          String?            @unique
  appleId           String?            @unique
  handle            String             @unique
  displayName       String
  avatarUrl         String?
  bio               String?
  locale            String             @default("en")
  contentLanguages  String[]           @default(["en"])
  countryCode       String?
  isMinor           Boolean            @default(false)
  roles             UserRole[]         @default([FAN])
  verificationStatus VerificationStatus @default(UNVERIFIED)
  anonymityDefault  Boolean            @default(false)
  monthlySpendCap   Decimal?           @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastActiveAt      DateTime           @default(now())

  fanProfile        FanProfile?
  favoriteProfile   FavoriteProfile?
  tokenWallet       TokenWallet?
  giftsSent         Gift[]             @relation("GiftsSent")
  giftsReceived     Gift[]             @relation("GiftsReceived")
  follows           Follow[]           @relation("Follower")
  followers         Follow[]           @relation("Following")
  badges            UserBadge[]
  reportsFiled      Report[]           @relation("Reporter")
  notifications     Notification[]
  sessions          Session[]

  @@index([handle])
  @@index([countryCode])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model FanProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalGiftsSent  Int      @default(0)
  createdAt       DateTime @default(now())
}

model FavoriteProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverUrl            String?
  categoryId          String?
  category            Category?          @relation(fields: [categoryId], references: [id])
  specialtyIds        String[]
  accentColor         String?
  supporterCount      Int                @default(0)
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verificationDocs    Json?
  isPublished         Boolean            @default(false)
  shortUrl            String?            @unique
  giftPointsBalance   Decimal            @default(0) @db.Decimal(14, 2)
  pendingGiftPoints   Decimal            @default(0) @db.Decimal(14, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  moments             Moment[]
  posts               Post[]
  giftsReceived       Gift[]             @relation("FavoriteGifts")
  supporterLevels     SupporterLevel[]
  campaigns           Campaign[]
  earnings            Earning[]
  payouts             Payout[]
  signatureGifts      GiftCatalogItem[]  @relation("SignatureGifts")
  featuredGifts       String[]

  @@index([categoryId])
  @@index([isPublished])
}

// ─── Taxonomy (Industry → Category → Specialty) ────────────────────────────

model Industry {
  id         String     @id @default(uuid())
  slug       String     @unique
  name       String
  nameI18n   Json?
  sortOrder  Int        @default(0)
  categories Category[]
}

model Category {
  id          String            @id @default(uuid())
  industryId  String
  industry    Industry          @relation(fields: [industryId], references: [id])
  slug        String            @unique
  name        String
  nameI18n    Json?
  specialties Specialty[]
  favorites   FavoriteProfile[]
}

model Specialty {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  slug       String   @unique
  name       String
  nameI18n   Json?
  modules    Json?    // page modules config
}

// ─── Tokens & Gifts ────────────────────────────────────────────────────────

model TokenWallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Int      @default(0) // tokens
  giftedBalance   Int      @default(0) // fan-to-fan gifted tokens (restricted)
  totalPurchased  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model TokenPack {
  id          String   @id @default(uuid())
  name        String
  tokens      Int
  bonusTokens Int      @default(0)
  priceCents  Int
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

model TokenPurchase {
  id              String   @id @default(uuid())
  userId          String
  packId          String?
  tokens          Int
  amountCents     Int
  currency        String
  paymentMethod   String
  paymentProvider String?
  providerRef     String?
  status          String   @default("pending") // pending, completed, failed, refunded
  createdAt       DateTime @default(now())

  @@index([userId])
}

model GiftCatalogItem {
  id              String           @id @default(uuid())
  slug            String           @unique
  name            String
  nameI18n        Json?
  description     String?
  tokenCost       Int
  animationUrl    String?
  iconUrl         String?
  type            String           // standard, category, cultural, limited, signature, combo
  categoryId      String?
  favoriteId      String?          // for signature gifts
  favorite        FavoriteProfile? @relation("SignatureGifts", fields: [favoriteId], references: [id])
  isActive        Boolean          @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int              @default(0)
}

model Gift {
  id              String           @id @default(uuid())
  senderId        String
  sender          User             @relation("GiftsSent", fields: [senderId], references: [id])
  receiverId      String           // Favorite's user id
  receiver        User             @relation("GiftsReceived", fields: [receiverId], references: [id])
  favoriteId      String
  favorite        FavoriteProfile  @relation("FavoriteGifts", fields: [favoriteId], references: [id])
  catalogItemId   String
  tokenCost       Int
  giftPoints      Decimal          @db.Decimal(12, 2)
  message         String?
  isAnonymous     Boolean          @default(false)
  momentId        String?
  moment          Moment?          @relation(fields: [momentId], references: [id])
  postId          String?
  status          String           @default("completed") // completed, held, refunded
  createdAt       DateTime         @default(now())

  @@index([favoriteId, createdAt])
  @@index([senderId])
  @@index([momentId])
}

// ─── Moments & Feeds ───────────────────────────────────────────────────────

enum MomentType {
  FAVORITE
  FAN
  PLATFORM
  LIVE
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  SUPPORTERS
  TIER
}

model Moment {
  id            String      @id @default(uuid())
  favoriteId    String
  favorite      FavoriteProfile @relation(fields: [favoriteId], references: [id])
  authorId      String
  type          MomentType  @default(FAVORITE)
  title         String
  description   String?
  mediaUrl      String?
  mediaType     String?     // image, audio, video, link
  categoryTag   String?
  visibility    Visibility  @default(PUBLIC)
  isFlash       Boolean     @default(false) // 24h
  expiresAt     DateTime?
  supportCount  Int         @default(0)
  reactionCount Int         @default(0)
  commentCount  Int         @default(0)
  sourceLang    String?
  isApproved    Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gifts         Gift[]
  reactions     Reaction[]
  comments      Comment[]

  @@index([favoriteId, createdAt])
  @@index([type, createdAt])
}

model Post {
  id            String      @id @default(uuid())
  favoriteId    String
  favorite      FavoriteProfile @relation(fields: [favoriteId], references: [id])
  authorId      String
  body          String
  mediaUrls     String[]
  visibility    Visibility  @default(PUBLIC)
  sourceLang    String?
  isPinned      Boolean     @default(false)
  reactionCount Int         @default(0)
  commentCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  comments      Comment[]
  reactions     Reaction[]

  @@index([favoriteId, createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  authorId   String
  body       String
  sourceLang String?
  momentId   String?
  moment     Moment?  @relation(fields: [momentId], references: [id])
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id])
  parentId   String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([momentId])
  @@index([postId])
}

model Reaction {
  id        String   @id @default(uuid())
  userId    String
  type      String   // like, love, fire, etc.
  momentId  String?
  moment    Moment?  @relation(fields: [momentId], references: [id])
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, momentId, type])
  @@unique([userId, postId, type])
}

// ─── Social Graph ──────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─── Recognition ───────────────────────────────────────────────────────────

model BadgeDefinition {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  nameI18n    Json?
  description String?
  iconUrl     String?
  ruleType    String   // first_supporter, day_one, top_10, streak, custom
  ruleConfig  Json?
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  badgeId    String
  favoriteId String?  // per-Favorite badges
  awardedAt  DateTime @default(now())

  @@unique([userId, badgeId, favoriteId])
}

model SupporterLevel {
  id          String          @id @default(uuid())
  favoriteId  String
  favorite    FavoriteProfile @relation(fields: [favoriteId], references: [id])
  userId      String
  level       String          // bronze, silver, gold, platinum, diamond
  cumulative  Decimal         @db.Decimal(14, 2)
  updatedAt   DateTime        @updatedAt

  @@unique([favoriteId, userId])
}

// ─── Campaigns (Charity) ───────────────────────────────────────────────────

model VerifiedBeneficiary {
  id              String   @id @default(uuid())
  name            String
  registrationId  String?
  countryCode     String
  bankVerified    Boolean  @default(false)
  status          String   @default("pending")
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
}

model Campaign {
  id              String              @id @default(uuid())
  favoriteId      String
  favorite        FavoriteProfile     @relation(fields: [favoriteId], references: [id])
  beneficiaryId   String
  title           String
  description     String?
  goalAmount      Decimal             @db.Decimal(14, 2)
  raisedAmount    Decimal             @default(0) @db.Decimal(14, 2)
  currency        String              @default("USD")
  type            String              // fixed_goal, ongoing
  status          String              @default("draft") // draft, active, completed, cancelled
  deadline        DateTime?
  impactReport    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([favoriteId])
  @@index([status])
}

// ─── Earnings & Payouts ────────────────────────────────────────────────────

model Earning {
  id          String          @id @default(uuid())
  favoriteId  String
  favorite    FavoriteProfile @relation(fields: [favoriteId], references: [id])
  sourceType  String          // gift, subscription, store
  sourceId    String?
  amount      Decimal         @db.Decimal(14, 2)
  currency    String
  status      String          @default("pending") // pending, available, paid
  createdAt   DateTime        @default(now())

  @@index([favoriteId, status])
}

model Payout {
  id              String          @id @default(uuid())
  favoriteId      String
  favorite        FavoriteProfile @relation(fields: [favoriteId], references: [id])
  amount          Decimal         @db.Decimal(14, 2)
  currency        String
  method          String          // bank, mobile_money
  destination     Json
  status          String          @default("pending")
  fee             Decimal         @default(0) @db.Decimal(10, 2)
  isOnDemand      Boolean         @default(false)
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([favoriteId])
}

// ─── Trust & Safety ────────────────────────────────────────────────────────

model Report {
  id           String   @id @default(uuid())
  reporterId   String
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id])
  targetType   String   // user, post, comment, moment, gift
  targetId     String
  reason       String
  evidence     String?
  status       String   @default("open") // open, reviewing, resolved, dismissed
  resolution   String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([status])
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}
