// Rally Fan Support Platform - Database Schema
// Based on PRD v2.0 - MVP (P0) + Phase 2 (P1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Accounts ───────────────────────────────────────────────────

enum UserRole {
  FAN
  FAVORITE
  MANAGER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phone             String?            @unique
  passwordHash      String?
  googleId          String?            @unique
  appleId           String?            @unique
  handle            String             @unique
  displayName       String
  avatarUrl         String?
  bio               String?
  locale            String             @default("en")
  contentLanguages  String[]           @default(["en"])
  countryCode       String?
  isMinor           Boolean            @default(false)
  city              String?            // Phase 3: city ranking lanes (RNK)
  region            String?            // Phase 3: region ranking lanes
  roles             UserRole[]         @default([FAN])
  verificationStatus VerificationStatus @default(UNVERIFIED)
  phoneVerifiedAt   DateTime?           // ACC-1: verified phone before first Token purchase
  socialVerifiedAt  DateTime?           // ACC-1: social login counts as verified
  anonymityDefault  Boolean            @default(false)
  monthlySpendCap   Decimal?           @db.Decimal(12, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lastActiveAt      DateTime           @default(now())

  fanProfile        FanProfile?
  favoriteProfile   FavoriteProfile?
  tokenWallet       TokenWallet?
  giftsSent         Gift[]             @relation("GiftsSent")
  giftsReceived     Gift[]             @relation("GiftsReceived")
  follows           Follow[]           @relation("Follower")
  followers         Follow[]           @relation("Following")
  badges            UserBadge[]
  reportsFiled      Report[]           @relation("Reporter")
  notifications     Notification[]
  sessions          Session[]

  @@index([handle])
  @@index([countryCode])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// OTP codes for phone verification (ACC-1). Plain FK, no relation.
model OtpCode {
  id         String    @id @default(uuid())
  userId     String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, phone])
}

model FanProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalGiftsSent  Int      @default(0)
  createdAt       DateTime @default(now())
}

model FavoriteProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverUrl            String?
  categoryId          String?
  category            Category?          @relation(fields: [categoryId], references: [id])
  specialtyIds        String[]
  accentColor         String?
  supporterCount      Int                @default(0)
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  verificationDocs    Json?
  isPublished         Boolean            @default(false)
  shortUrl            String?            @unique
  giftPointsBalance   Decimal            @default(0) @db.Decimal(14, 2)
  pendingGiftPoints   Decimal            @default(0) @db.Decimal(14, 2)
  cohort              String             @default("rising") // rising, established, legend (RNK-6)
  showInRankings      Boolean            @default(true)     // RNK-6: opt out of public ranking
  probationEndsAt    DateTime?           // UPG-5: 30-day probation for upgraded fans
  isJunior           Boolean            @default(false) // Phase 3: Junior Favorite (UPG-7), no payouts
  city               String?            // Phase 3: city/region lane (RNK)
  region             String?            // Phase 3
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  moments             Moment[]
  posts               Post[]
  giftsReceived       Gift[]             @relation("FavoriteGifts")
  supporterLevels     SupporterLevel[]
  campaigns           Campaign[]
  earnings            Earning[]
  payouts             Payout[]
  signatureGifts      GiftCatalogItem[]  @relation("SignatureGifts")
  featuredGifts       String[]

  @@index([categoryId])
  @@index([isPublished])
}

// ─── Taxonomy (Industry → Category → Specialty) ────────────────────────────

model Industry {
  id         String     @id @default(uuid())
  slug       String     @unique
  name       String
  nameI18n   Json?
  sortOrder  Int        @default(0)
  categories Category[]
}

model Category {
  id          String            @id @default(uuid())
  industryId  String
  industry    Industry          @relation(fields: [industryId], references: [id])
  slug        String            @unique
  name        String
  nameI18n    Json?
  specialties Specialty[]
  favorites   FavoriteProfile[]
}

model Specialty {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  slug       String   @unique
  name       String
  nameI18n   Json?
  modules    Json?    // page modules config
}

// ─── Tokens & Gifts ────────────────────────────────────────────────────────

model TokenWallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance         Int      @default(0) // tokens
  giftedBalance   Int      @default(0) // fan-to-fan gifted tokens (restricted, FFG-2)
  totalPurchased  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model TokenPack {
  id          String     @id @default(uuid())
  name        String
  tokens      Int
  bonusTokens Int        @default(0)
  priceCents  Int
  currency    String     @default("USD")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
}

model TokenPurchase {
  id              String   @id @default(uuid())
  userId          String
  packId          String?
  tokens          Int
  amountCents    Int
  currency        String
  paymentMethod   String
  paymentProvider String?
  providerRef     String?
  status          String   @default("pending") // pending, completed, failed, refunded
  createdAt       DateTime @default(now())

  @@index([userId])
}

model GiftCatalogItem {
  id              String           @id @default(uuid())
  slug            String           @unique
  name            String
  nameI18n        Json?
  description     String?
  tokenCost       Int
  animationUrl    String?
  iconUrl         String?
  type            String           // standard, category, cultural, limited, signature, combo, fan_cosmetic
  categoryId      String?
  favoriteId      String?          // for signature gifts
  favorite        FavoriteProfile? @relation("SignatureGifts", fields: [favoriteId], references: [id])
  isActive        Boolean          @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int              @default(0)
}

model Gift {
  id              String           @id @default(uuid())
  senderId        String
  sender          User             @relation("GiftsSent", fields: [senderId], references: [id])
  receiverId      String           // Favorite's user id
  receiver        User             @relation("GiftsReceived", fields: [receiverId], references: [id])
  favoriteId      String
  favorite        FavoriteProfile  @relation("FavoriteGifts", fields: [favoriteId], references: [id])
  catalogItemId   String
  tokenCost       Int
  giftPoints      Decimal          @db.Decimal(12, 2)
  message         String?
  isAnonymous     Boolean          @default(false)
  momentId        String?
  moment          Moment?          @relation(fields: [momentId], references: [id])
  postId          String?
  sessionId       String?  // live session gift (GFT-10)
  status          String           @default("completed") // completed, held, refunded
  createdAt       DateTime         @default(now())

  @@index([favoriteId, createdAt])
  @@index([senderId])
  @@index([momentId])
}

// ─── Fan-to-Fan Gifting (P1, FFG) ──────────────────────────────────────────

model FanGift {
  id             String    @id @default(uuid())
  senderId       String
  recipientId    String
  kind           String    // cosmetic | tokens
  catalogItemId  String?   // cosmetic items
  tokens         Int       @default(0) // escrowed token gift amount
  message        String?
  status         String    @default("pending") // pending, accepted, declined, recovered, expired
  expiresAt      DateTime  // 72h acceptance window (FFG-8)
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId, status])
}

// ─── Fan Clubs / Subscriptions (P1, SUB) ────────────────────────────────────

model SubscriptionTier {
  id          String   @id @default(uuid())
  favoriteId  String
  name        String
  description String?
  priceCents  Int
  currency    String   @default("USD")
  perks       String[]
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String
  tierId            String
  favoriteId        String
  status            String    @default("active") // active, paused, cancelled
  autoRenew         Boolean   @default(true)
  startedAt         DateTime  @default(now())
  currentPeriodEnd  DateTime
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([favoriteId, status])
}

// ─── Store & Commissions (P1, SUB-3..5) ────────────────────────────────────

model StoreItem {
  id                  String   @id @default(uuid())
  favoriteId          String
  title               String
  description         String?
  previewUrl          String?
  priceCents          Int
  currency            String   @default("USD")
  deliveryType        String   // download, link, message
  deliveryWindowDays  Int      @default(7)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model StoreOrder {
  id              String    @id @default(uuid())
  itemId          String
  favoriteId      String
  buyerId         String
  amountCents     Int
  currency        String    @default("USD")
  platformFee     Decimal   @default(0) @db.Decimal(10, 2)
  status          String    @default("pending") // pending, delivered, refunded
  deliveryProof   String?
  dueAt           DateTime
  deliveredAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([buyerId])
  @@index([favoriteId, status])
}

// ─── Giveaways (P1, GVW) ───────────────────────────────────────────────────

model Giveaway {
  id                String    @id @default(uuid())
  favoriteId        String
  poolAmount        Decimal   @db.Decimal(14, 2)
  currency          String    @default("USD")
  winnerCount       Int
  split             String    @default("equal") // equal | tiered
  weights           Json?     // { activeness, dedication, passion } each 0.2..0.5
  scoreWindowDays   Int       @default(30)
  entryOpensAt      DateTime
  entryClosesAt     DateTime
  status            String    @default("draft") // draft, funded, announced, closed, drawn, paid, cancelled
  fee               Decimal   @default(0) @db.Decimal(10, 2)
  seedHash          String?   // provable fairness: sha256 of secret seed (GVW-6)
  seedRevealed      String?
  publicRandom      String?
  countryFilter     String?
  prizeKind         String             @default("cash") // cash | tokens (Q33 Phase 3, with controls)
  tokenPrize        Int                @default(0) // tokens per winner when prizeKind=tokens
  sponsorId         String?            // Phase 3: brand-sponsored giveaway
  sponsorLabel      String?            // clear labeling on the giveaway page
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([favoriteId, status])
}

model GiveawayEntry {
  id               String   @id @default(uuid())
  giveawayId       String
  userId           String
  enteredAt        DateTime @default(now())
  withdrawnAt      DateTime?
  activenessScore  Decimal? @db.Decimal(5, 4)
  dedicationScore  Decimal? @db.Decimal(5, 4)
  passionScore     Decimal? @db.Decimal(5, 4)
  drawWeight       Decimal? @db.Decimal(5, 4)
  isWinner         Boolean  @default(false)
  isAlternate      Boolean  @default(false)
  rank             Int?

  @@unique([giveawayId, userId])
}

// ─── Fan Upgrade Path (P1, UPG) ─────────────────────────────────────────────

model UpgradeRequest {
  id                 String    @id @default(uuid())
  userId             String
  specialtyId        String?
  pitch              String
  samples            String[]
  references         String[]
  declaredLinks      String?   // relationships with other Favorites (UPG-2)
  status             String    @default("screening") // screening, pending, approved, rejected, conditional
  screeningResult    Json?
  reviewerNote       String?
  rejectionReasons   String[]
  probationEndsAt    DateTime?
  createdAt          DateTime  @default(now())
  decidedAt          DateTime?

  @@index([userId])
}

// ─── Collections (P1, MOM-5) ────────────────────────────────────────────────

model Collection {
  id        String   @id @default(uuid())
  userId    String
  title     String
  isPublic  Boolean  @default(false)
  momentIds String[]
  createdAt DateTime @default(now())
}

// ─── Team Roles (P1, ACC-7) ─────────────────────────────────────────────────

model TeamMember {
  id          String   @id @default(uuid())
  favoriteId  String
  userId      String
  role        String   // manager | moderator
  permissions String[] // e.g. moderate_comments, review_moments, pin_posts
  invitedBy   String?
  addedAt     DateTime @default(now())
  auditLog    Json?

  @@unique([favoriteId, userId])
}

// ─── Rivalries (P1, RIV) ────────────────────────────────────────────────────

model Rivalry {
  id          String    @id @default(uuid())
  favoriteAId String
  favoriteBId String
  optInA      Boolean   @default(false) // RIV-1: both must opt in for interactive features
  optInB      Boolean   @default(false)
  status      String    @default("documented") // documented | active | paused
  heatLevel   Int       @default(1)            // RIV-6 Beef Radar 1..5
  summary     String?
  sources     Json?
  updatedAt   DateTime  @updatedAt

  @@unique([favoriteAId, favoriteBId])
}

model FaceOff {
  id          String   @id @default(uuid())
  rivalryId   String?
  favoriteAId String
  favoriteBId String
  question    String
  status      String   @default("open") // open, closed, locked
  votesA      Int      @default(0)
  votesB      Int      @default(0)
  opensAt     DateTime @default(now())
  closesAt    DateTime
  createdAt   DateTime  @default(now())
}

// ─── Moments & Feeds ────────────────────────────────────────────────────────

enum MomentType {
  FAVORITE
  FAN
  PLATFORM
  LIVE
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  SUPPORTERS
  TIER
}

model Moment {
  id            String      @id @default(uuid())
  favoriteId    String
  favorite      FavoriteProfile @relation(fields: [favoriteId], references: [id])
  authorId      String
  type          MomentType  @default(FAVORITE)
  title         String
  description   String?
  mediaUrl      String?
  mediaType     String?     // image, audio, video, link
  categoryTag   String?
  visibility    Visibility  @default(PUBLIC)
  isFlash       Boolean     @default(false) // 24h
  expiresAt     DateTime?
  supportCount  Int         @default(0)
  reactionCount Int         @default(0)
  commentCount  Int         @default(0)
  sourceLang    String?
  isApproved    Boolean     @default(true)  // false while in Fan Moment approval queue (MOM-4)
  isFeatured    Boolean     @default(false) // featured by Favorite/moderators (MOM-4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gifts         Gift[]
  reactions     Reaction[]
  comments      Comment[]

  @@index([favoriteId, createdAt])
  @@index([type, createdAt])
}

model Post {
  id            String      @id @default(uuid())
  favoriteId    String
  favorite      FavoriteProfile @relation(fields: [favoriteId], references: [id])
  authorId      String
  body          String
  mediaUrls     String[]
  visibility    Visibility  @default(PUBLIC)
  sourceLang    String?
  isPinned      Boolean     @default(false)
  reactionCount Int         @default(0)
  commentCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  comments      Comment[]
  reactions     Reaction[]

  @@index([favoriteId, createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  authorId   String
  body       String
  sourceLang String?
  momentId   String?
  moment     Moment?  @relation(fields: [momentId], references: [id])
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id])
  parentId   String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([momentId])
  @@index([postId])
}

model Reaction {
  id        String   @id @default(uuid())
  userId    String
  type      String   // like, love, fire, etc.
  momentId  String?
  moment    Moment?  @relation(fields: [momentId], references: [id])
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, momentId, type])
  @@unique([userId, postId, type])
}

// ─── Social Graph ──────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─── Recognition ───────────────────────────────────────────────────────────

model BadgeDefinition {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  nameI18n    Json?
  description String?
  iconUrl     String?
  ruleType    String   // first_supporter, day_one, top_10, streak, translator, impact, custom
  ruleConfig  Json?
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  badgeId    String
  favoriteId String?  // per-Favorite badges
  awardedAt  DateTime @default(now())

  @@unique([userId, badgeId, favoriteId])
}

model SupporterLevel {
  id          String          @id @default(uuid())
  favoriteId  String
  favorite    FavoriteProfile @relation(fields: [favoriteId], references: [id])
  userId      String
  level       String          // bronze, silver, gold, platinum, diamond
  cumulative  Decimal         @db.Decimal(14, 2)
  updatedAt   DateTime        @updatedAt

  @@unique([favoriteId, userId])
}

// ─── Campaigns (Charity) ───────────────────────────────────────────────────

model VerifiedBeneficiary {
  id              String   @id @default(uuid())
  name            String
  registrationId  String?
  countryCode     String
  bankVerified    Boolean  @default(false)
  status          String   @default("pending")
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
}

model Campaign {
  id              String              @id @default(uuid())
  favoriteId      String
  favorite        FavoriteProfile     @relation(fields: [favoriteId], references: [id])
  beneficiaryId   String
  title           String
  description     String?
  goalAmount      Decimal             @db.Decimal(14, 2)
  raisedAmount    Decimal             @default(0) @db.Decimal(14, 2)
  currency        String              @default("USD")
  type            String              // fixed_goal, ongoing
  status          String              @default("draft") // draft, active, completed, cancelled
  deadline        DateTime?
  impactReport    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([favoriteId])
  @@index([status])
}

// ─── Earnings & Payouts ────────────────────────────────────────────────────

model Earning {
  id          String          @id @default(uuid())
  favoriteId  String
  favorite    FavoriteProfile @relation(fields: [favoriteId], references: [id])
  sourceType  String          // gift, subscription, store
  sourceId    String?
  amount      Decimal         @db.Decimal(14, 2)
  currency    String
  status      String          @default("pending") // pending, available, paid
  createdAt   DateTime        @default(now())

  @@index([favoriteId, status])
}

model Payout {
  id              String          @id @default(uuid())
  favoriteId      String
  favorite        FavoriteProfile @relation(fields: [favoriteId], references: [id])
  amount          Decimal         @db.Decimal(14, 2)
  currency        String
  method          String          // bank, mobile_money
  destination     Json
  status          String          @default("pending")
  fee             Decimal         @default(0) @db.Decimal(10, 2)
  isOnDemand      Boolean         @default(false)
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([favoriteId])
}

// ─── Trust & Safety ────────────────────────────────────────────────────────

model Report {
  id           String   @id @default(uuid())
  reporterId   String
  reporter     User     @relation("Reporter", fields: [reporterId], references: [id])
  targetType   String   // user, post, comment, moment, gift, campaign, giveaway
  targetId     String
  reason       String
  evidence     String?
  status       String   @default("open") // open, reviewing, resolved, dismissed
  resolution   String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([status])
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ─── Phase 3 (P2) ───────────────────────────────────────────────────────────

// UPG-7: guardian-consent Junior Favorite program (16-17), no payouts.
model JuniorFavorite {
  id               String    @id @default(uuid())
  userId           String    @unique
  guardianName     String
  guardianPhone    String
  guardianEmail    String?
  consentCodeHash  String
  consentAt       DateTime?
  status           String    @default("pending") // pending, consented, approved, rejected, revoked
  favoriteId       String?
  reviewedBy       String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

// Brand partnerships: sponsor KYB, escrowed token prize pool.
model BrandSponsor {
  id           String   @id @default(uuid())
  name         String
  contactEmail String
  countryCode  String   @default("NG")
  kybDocs      Json?
  kybStatus    String   @default("pending") // pending, approved, rejected
  tokenEscrow  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Live audio/video sessions (GFT-10).
model LiveSession {
  id          String    @id @default(uuid())
  favoriteId  String
  title       String
  kind        String    @default("audio") // audio | video
  status      String    @default("scheduled") // scheduled, live, paused, ended
  streamUrl   String?
  isPaused    Boolean   @default(false)
  viewerCount Int       @default(0)
  startsAt    DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([favoriteId, status])
  @@index([status, createdAt])
}

model LiveAttendance {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([sessionId, userId])
}

// Merch partners & fulfillment.
model MerchPartner {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model MerchItem {
  id                   String   @id @default(uuid())
  favoriteId           String
  title                String
  description          String?
  imageUrl             String?
  priceCents           Int
  currency             String   @default("USD")
  variants             Json?
  deliveryWindowDays   Int      @default(14)
  fulfillmentPartnerId String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
}

model MerchOrder {
  id              String   @id @default(uuid())
  itemId          String
  favoriteId      String
  buyerId         String
  amountCents     Int
  currency        String   @default("USD")
  platformFee     Decimal  @default(0) @db.Decimal(10, 2)
  shippingAddress Json
  status          String   @default("paid") // paid, shipped, delivered, refunded, cancelled
  trackingCode    String?
  dueAt           DateTime
  fulfilledAt     DateTime?
  deliveredAt     DateTime?
  refundedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([buyerId])
  @@index([favoriteId, status])
}

// Predictions with prizes where legal.
model Prediction {
  id          String    @id @default(uuid())
  favoriteAId String
  favoriteBId String
  question    String
  closesAt    DateTime
  outcome     String?
  prizeKind   String    @default("none") // none | tokens
  tokenPrize  Int       @default(0)
  countryCode String?
  status      String    @default("open") // open, settled
  createdAt   DateTime  @default(now())
  settledAt   DateTime?

  @@index([status, closesAt])
}

model PredictionEntry {
  id           String   @id @default(uuid())
  predictionId String
  userId       String
  choice       String
  isCorrect    Boolean?
  prizeAwarded Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([predictionId, userId])
}

// City and region ranking lanes (RNK, Phase 3) — monthly snapshots.
model CityRankingSnapshot {
  id          String   @id @default(uuid())
  city        String
  region      String?
  periodStart DateTime
  favoriteId  String
  rank        Int
  score       Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  @@index([city, periodStart])
}
